# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local dev database
.local-mongo-data/

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# Local copy of the Actions cron secret - never commit.
CRON_SECRET.txt
