# MongoDB Atlas connection string. Leave unset in development to use a
# zero-config local MongoDB (see lib/db.ts) — required in production.
MONGODB_URI=

# Secret used to sign session JWTs (SIWE login). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# WalletConnect Cloud project id (required for the wallet connect modal).
# Get one free at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Only needed to run `npm run indexer` (scripts/indexer.ts) against a real
# deployment — see contracts/deployments.json after `npx hardhat run
# scripts/deploy.ts --network <name>` inside contracts/.
INDEXER_RPC_URL=
DURCHEX_NFT_ADDRESS=
DURCHEX_MARKETPLACE_ADDRESS=

# Client-side: the marketplace contract address the "Buy Now" button calls.
# Only collections whose `contractAddress` + `chainId` match a real
# deployment get a working Buy Now — everything else shows a "not wired up
# yet" notice instead of pretending to transact.
NEXT_PUBLIC_MARKETPLACE_ADDRESS=

# Set automatically when you create and connect a public Vercel Blob store.
# Required for creator uploads of images, GIFs, video, and audio.
BLOB_READ_WRITE_TOKEN=
