# Copy to .env and fill in. This file lives in contracts/ only and is
# gitignored — never commit real values, and never paste DEPLOYER_PRIVATE_KEY
# anywhere outside this file (not into chat, not into a script argument).

# RPC endpoints — get free ones at https://alchemy.com or https://infura.io
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
AMOY_RPC_URL=
POLYGON_RPC_URL=

# The deployer wallet's private key (0x-prefixed). Use a fresh wallet made
# just for deployment, not one holding other funds/NFTs.
DEPLOYER_PRIVATE_KEY=

# Where primary sale + marketplace fees get paid out. Defaults to the
# deployer address if left blank.
FEE_RECIPIENT_ADDRESS=

# For `npm run verify:sepolia` / `verify:mainnet` — publishes source on
# Etherscan so buyers can read the contract. Free at https://etherscan.io/apis
ETHERSCAN_API_KEY=
